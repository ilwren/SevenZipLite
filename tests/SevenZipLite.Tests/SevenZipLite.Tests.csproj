<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\SevenZipLite\SevenZipLite.csproj" />
    <ProjectReference Include="..\SevenZipLite.SelfTest\SevenZipLite.SelfTest.csproj" />
  </ItemGroup>

  <!--
    原生库的唯一来源是仓库根目录的 native-libs/（见该目录下的 README.md），本项目只是
    按运行平台 Link 对应的那一份，不再保留自己的拷贝。这里按宿主 OS 自动选择 win-x64
    还是 linux-x64（开发机 `dotnet run`/`dotnet test` 不显式指定 RuntimeIdentifier 时，
    MSBuild 不会告诉我们目标平台，只能用 $([MSBuild]::IsOSPlatform(...)) 推断"当前就是
    目标平台"——这对不做跨平台发布、只是"在本机跑一遍自检"的测试项目完全够用）。
    这套"按 OS 自动选 RID"的写法和 samples/SevenZipLite.AvaloniaDemo.csproj 里的
    _AvaloniaDemoNativeRid 是同一个模式，便于 CI 矩阵（ubuntu-latest/windows-latest）
    不用改任何项目文件就能跑通同一份自检用例。macOS 没有对应的原生库（native-libs/
    下没有 osx-* 目录），因此本项目不支持、也不在 CI 矩阵里跑 macos-latest。

    Single source of truth for the native binary is the repo-root native-libs/ folder
    (see its README.md); this project just links to whichever one matches the host OS,
    no local copies. OS auto-detection here (rather than relying on an explicit
    RuntimeIdentifier) mirrors the same pattern used by
    samples/SevenZipLite.AvaloniaDemo.csproj's _AvaloniaDemoNativeRid, so the CI matrix
    (ubuntu-latest/windows-latest) can run the exact same self-test suite without any
    project-file changes. There's no macOS binary in native-libs/ (no osx-* folder), so
    this project isn't supported on, and isn't run against, macos-latest in CI.
  -->
  <PropertyGroup>
    <_TestsNativeRid Condition="'$(_TestsNativeRid)' == '' And '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_TestsNativeRid>
    <_TestsNativeRid Condition="'$(_TestsNativeRid)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-x64</_TestsNativeRid>
    <_TestsNativeRid Condition="'$(_TestsNativeRid)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</_TestsNativeRid>
  </PropertyGroup>

  <ItemGroup Condition="'$(_TestsNativeRid)' == 'win-x64' And Exists('..\..\native-libs\win-x64\7zlite.dll')">
    <None Include="..\..\native-libs\win-x64\7zlite.dll" Link="7zlite.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(_TestsNativeRid)' == 'linux-x64' And Exists('..\..\native-libs\linux-x64\lib7zlite.so')">
    <None Include="..\..\native-libs\linux-x64\lib7zlite.so" Link="lib7zlite.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
