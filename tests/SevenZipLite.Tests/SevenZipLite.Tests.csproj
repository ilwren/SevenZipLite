<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\SevenZipLite\SevenZipLite.csproj" />
    <ProjectReference Include="..\SevenZipLite.SelfTest\SevenZipLite.SelfTest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      linux-x64 原生库的唯一来源是仓库根目录的 native-libs/（见该目录下的 README.md），
      本项目只是 Link 引用，不再保留自己的拷贝。
      Single source of truth for the linux-x64 native binary is the repo-root
      native-libs/ folder (see its README.md); this project just links to it.
    -->
    <None Include="..\..\native-libs\linux-x64\lib7zlite.so" Link="lib7zlite.so" Condition="Exists('..\..\native-libs\linux-x64\lib7zlite.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
